# Copy to backend/.env and fill in. Never commit the real .env.

# auto | anthropic | mock
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise offline templates.
AI_PROVIDER=auto

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4000

# Where the local JSON store lives.
DATA_DIR=./data

# Origins allowed to call this API.
#
# Naming anything other than localhost here means the backend is reachable from
# somewhere else, and the app will refuse to start unless accounts are on --
# local mode has no sign-in, so every endpoint would be open to whoever found
# the URL. Deployed, this is your frontend's domain:
#   CORS_ORIGINS=https://vibe.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many reply generations one person may ask for. This is the only endpoint
# that spends money, and the API key it spends is yours, not theirs. 0 disables
# a ceiling; the defaults are generous for one person and stingy for a script.
SUGGEST_PER_MINUTE=6
SUGGEST_PER_HOUR=60

# Keep this false. Message bodies are private and should not be written to logs.
LOG_MESSAGE_CONTENT=false

# --- Accounts (optional) ----------------------------------------------------
# Leave both blank for single-user local mode: everything stays in DATA_DIR on
# this machine and no sign-in is needed.
#
# Set BOTH to switch on Supabase accounts. Apply supabase/schema.sql first.
# Find them in your project: Settings -> API.
#
# Use the *anon* (publishable) key. It is public by design -- Row Level Security
# is what protects the data. NEVER put the service_role key here: it bypasses
# RLS entirely and the app does not support it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
