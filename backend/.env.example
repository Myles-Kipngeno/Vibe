# Copy to backend/.env and fill in. Never commit the real .env.

# auto | anthropic | mock
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise offline templates.
AI_PROVIDER=auto

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4000

# Where the local JSON store lives.
DATA_DIR=./data

# Frontend dev server origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep this false. Message bodies are private and should not be written to logs.
LOG_MESSAGE_CONTENT=false
