# Copy to frontend/.env.local and fill in. Only the ANON key belongs here --
# it is designed to be public, because Row Level Security is what protects the
# data. Never put a service-role key or an AI provider key in this file: every
# VITE_ value is compiled into the JavaScript bundle your users download.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the backend lives during development (defaults to http://127.0.0.1:8000)
# VITE_API_URL=http://127.0.0.1:8000
