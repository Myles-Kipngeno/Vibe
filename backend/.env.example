# Copy to backend/.env and fill in. Never commit the real .env.

# auto | anthropic | mock
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise offline templates.
AI_PROVIDER=auto

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4000

# Where the local JSON store lives.
DATA_DIR=./data

# Frontend dev server origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep this false. Message bodies are private and should not be written to logs.
LOG_MESSAGE_CONTENT=false

# --- Accounts (optional) ----------------------------------------------------
# Leave both blank for single-user local mode: everything stays in DATA_DIR on
# this machine and no sign-in is needed.
#
# Set BOTH to switch on Supabase accounts. Apply supabase/schema.sql first.
# Find them in your project: Settings -> API.
#
# Use the *anon* (publishable) key. It is public by design -- Row Level Security
# is what protects the data. NEVER put the service_role key here: it bypasses
# RLS entirely and the app does not support it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
