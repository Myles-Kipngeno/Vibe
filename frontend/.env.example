# Copy to frontend/.env.local and fill in. Only the ANON key belongs here --
# it is designed to be public, because Row Level Security is what protects the
# data. Never put a service-role key or an AI provider key in this file: every
# VITE_ value is compiled into the JavaScript bundle your users download.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the backend lives.
#
# Leave it unset in development: Vite proxies /api to 127.0.0.1:8000 and the
# app uses relative paths. A deployed frontend has no proxy and is not on the
# same host as the backend, so set it there to the backend's public URL --
# without it the built app requests /api from its own domain and reaches
# nothing.
# VITE_API_URL=https://vibe-api.fly.dev
